\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Values at each edge's two endpoints, plotted against one another, for the raw noise $f$ (left) and the spatially correlated field $u$ (right), computed on the Oregon Router network ($n=11{,}174$). Points clustering near the $y=x$ line indicate that connected vertices tend to share similar values. The stark contrast in correlation (0.111 versus 0.616) confirms that the Phase 3c solve introduces genuine spatial correlation.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:phase3_local_correlation}{{4}{11}{Values at each edge's two endpoints, plotted against one another, for the raw noise $f$ (left) and the spatially correlated field $u$ (right), computed on the Oregon Router network ($n=11{,}174$). Points clustering near the $y=x$ line indicate that connected vertices tend to share similar values. The stark contrast in correlation (0.111 versus 0.616) confirms that the Phase 3c solve introduces genuine spatial correlation}{figure.caption.4}{}}
